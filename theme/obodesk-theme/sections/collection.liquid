{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<section class="obodesk-collection">
  <div class="obodesk-collection__hero">
    <p class="obodesk-eyebrow">OboDesk Collection</p>
    <h1>{{ collection.title }}</h1>

    {% if collection.description != blank %}
      <div class="obodesk-collection__description">
        {{ collection.description }}
      </div>
    {% else %}
      <p class="obodesk-collection__description">
        Build a cleaner, more intentional desk environment with essentials selected for structure, focus, and flow.
      </p>
    {% endif %}
  </div>

  <div class="obodesk-collection__rail" aria-label="Setup categories">
    <span>Desk Setup</span>
    <span>Lighting</span>
    <span>Power</span>
    <span>Desk Infrastructure</span>
    <span>Kits</span>
  </div>

  <div class="collection-products">
    {% paginate collection.products by 20 %}
      {% for product in collection.products %}
        <article class="collection-product">
          {% if product.featured_image %}
            {% render 'image',
              class: 'collection-product__image',
              image: product.featured_image,
              url: product.url,
              width: 700,
              height: 700,
              crop: 'center'
            %}
          {% else %}
            <a class="collection-product__image collection-product__image--placeholder" href="{{ product.url }}">
              <span>{{ product.title | escape }}</span>
            </a>
          {% endif %}

          <div class="collection-product__content">
            <h2>{{ product.title | escape | link_to: product.url }}</h2>
            <p>{{ product.price | money }}</p>
          </div>
        </article>
      {% else %}
        <div class="obodesk-collection__empty">
          <p class="obodesk-eyebrow">Coming soon</p>
          <h2>Essentials are being prepared for this collection.</h2>
          <p>Use this space to shape the collection before products are published.</p>
        </div>
      {% endfor %}

      {{ paginate | default_pagination }}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
