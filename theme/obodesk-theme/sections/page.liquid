{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<section class="obodesk-page">
  <div class="obodesk-page__inner">
    <header class="obodesk-page__header">
      <p class="obodesk-eyebrow">OboDesk</p>
      <h1>{{ page.title }}</h1>
    </header>

    <div class="obodesk-page__content">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
