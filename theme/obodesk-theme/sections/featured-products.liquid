<section class="obodesk-section obodesk-featured">
  <div class="obodesk-section__header">
    <p class="obodesk-eyebrow">Featured Essentials</p>
    <h2>Start with the Pieces You Touch Every Day</h2>
    <p>V1 essentials are grouped by setup role, ready to be connected to real products later.</p>
  </div>

  <div class="obodesk-grid obodesk-grid--four">
    <article class="obodesk-product-card">
      <div class="obodesk-product-card__media"></div>
      <h3>Desk Surface</h3>
      <p>Mats and work zones for a more controlled base.</p>
    </article>
    <article class="obodesk-product-card">
      <div class="obodesk-product-card__media"></div>
      <h3>Monitor Support</h3>
      <p>Height, posture, and clearer screen alignment.</p>
    </article>
    <article class="obodesk-product-card">
      <div class="obodesk-product-card__media"></div>
      <h3>Cable Control</h3>
      <p>Clean paths for power, charging, and desk devices.</p>
    </article>
    <article class="obodesk-product-card">
      <div class="obodesk-product-card__media"></div>
      <h3>Atmosphere</h3>
      <p>Lighting and visual accents for better work rhythm.</p>
    </article>
  </div>

  <div class="obodesk-footer-cta">
    <p class="obodesk-eyebrow">Ready when your desk is</p>
    <h2>Start with the desk. Improve the way you work.</h2>
    <a class="obodesk-button obodesk-button--primary" href="{{ routes.all_products_collection_url }}">Explore OboDesk essentials</a>
  </div>
</section>

