<section class="obodesk-section obodesk-featured">
  <div class="obodesk-section__header">
    <p class="obodesk-eyebrow">Featured Essentials</p>
    <h2>Featured Essentials</h2>
    <p>Start with the pieces that shape a cleaner, more intentional desk environment.</p>
  </div>

  <div class="obodesk-grid obodesk-grid--four">
    <article class="obodesk-product-card">
      <div class="obodesk-product-card__media obodesk-product-card__media--riser" aria-hidden="true">
        <span class="obodesk-product-visual obodesk-product-visual--riser"></span>
      </div>
      <div class="obodesk-product-card__body">
        <span class="obodesk-product-card__tag">Structure</span>
        <h3>Signature Monitor Riser</h3>
        <p>Build structure into the center of your desk.</p>
        <a class="obodesk-product-card__link" href="{{ routes.all_products_collection_url }}">View essential</a>
      </div>
    </article>

    <article class="obodesk-product-card">
      <div class="obodesk-product-card__media obodesk-product-card__media--mat" aria-hidden="true">
        <span class="obodesk-product-visual obodesk-product-visual--mat"></span>
      </div>
      <div class="obodesk-product-card__body">
        <span class="obodesk-product-card__tag">Surface</span>
        <h3>Essential Desk Mat</h3>
        <p>Create a calmer surface for focus and flow.</p>
        <a class="obodesk-product-card__link" href="{{ routes.all_products_collection_url }}">View essential</a>
      </div>
    </article>

    <article class="obodesk-product-card">
      <div class="obodesk-product-card__media obodesk-product-card__media--sync" aria-hidden="true">
        <span class="obodesk-product-visual obodesk-product-visual--sync"></span>
      </div>
      <div class="obodesk-product-card__body">
        <span class="obodesk-product-card__tag">Atmosphere</span>
        <h3>Screen Sync Light</h3>
        <p>Add depth and atmosphere without visual clutter.</p>
        <a class="obodesk-product-card__link" href="{{ routes.all_products_collection_url }}">View essential</a>
      </div>
    </article>

    <article class="obodesk-product-card">
      <div class="obodesk-product-card__media obodesk-product-card__media--bar" aria-hidden="true">
        <span class="obodesk-product-visual obodesk-product-visual--bar"></span>
      </div>
      <div class="obodesk-product-card__body">
        <span class="obodesk-product-card__tag">Lighting</span>
        <h3>Monitor Light Bar</h3>
        <p>Cleaner task lighting for a more professional desk.</p>
        <a class="obodesk-product-card__link" href="{{ routes.all_products_collection_url }}">View essential</a>
      </div>
    </article>
  </div>

  <div class="obodesk-footer-cta">
    <p class="obodesk-eyebrow">Ready when your desk is</p>
    <h2>Start with the desk. Improve the way you work.</h2>
    <a class="obodesk-button obodesk-button--primary" href="{{ routes.all_products_collection_url }}">Explore all essentials</a>
  </div>
</section>

