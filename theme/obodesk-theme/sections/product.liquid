{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<section class="obodesk-product">
  <div class="obodesk-product__layout">
    <div class="obodesk-product__media">
      {% if product.media.size > 0 %}
        {% for media in product.media %}
          {% if media.media_type == 'image' %}
            {% render 'image',
              class: 'obodesk-product__image',
              image: media.preview_image,
              width: 1200,
              height: 1200,
              crop: 'center'
            %}
          {% endif %}
        {% endfor %}
      {% elsif product.images.size > 0 %}
        {% for image in product.images %}
          {% render 'image',
            class: 'obodesk-product__image',
            image: image,
            width: 1200,
            height: 1200,
            crop: 'center'
          %}
        {% endfor %}
      {% else %}
        <div class="obodesk-product__image obodesk-product__image--placeholder">
          <span>{{ product.title }}</span>
        </div>
      {% endif %}
    </div>

    <div class="obodesk-product__purchase">
      <div class="obodesk-product__summary">
        <p class="obodesk-eyebrow">OboDesk Essential</p>
        <h1>{{ product.title }}</h1>
        {% assign current_variant = product.selected_or_first_available_variant %}
        <p class="obodesk-product__price">
          {% if current_variant.compare_at_price > current_variant.price %}
            <s>{{ current_variant.compare_at_price | money }}</s>
          {% endif %}
          <span>{{ current_variant.price | money }}</span>
        </p>

        {% if product.description != blank %}
          <div class="obodesk-product__description">
            {{ product.description }}
          </div>
        {% endif %}
      </div>

      <div class="obodesk-product__form">
        {% form 'product', product %}
          {% assign can_add_to_cart = current_variant.available %}
          {% if current_variant.inventory_policy == 'continue' or product.available %}
            {% assign can_add_to_cart = true %}
          {% endif %}

          {% if product.has_only_default_variant or product.variants.size == 1 %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% else %}
            <label for="ProductVariant-{{ section.id }}">Configuration</label>
            <select id="ProductVariant-{{ section.id }}" name="id">
              {% for variant in product.variants %}
                {% assign variant_can_add_to_cart = variant.available %}
                {% if variant.inventory_policy == 'continue' %}
                  {% assign variant_can_add_to_cart = true %}
                {% endif %}
                <option
                  value="{{ variant.id }}"
                  data-available="{{ variant_can_add_to_cart }}"
                  {% if variant == current_variant %}
                    selected="selected"
                  {% endif %}
                >
                  {{ variant.title }} - {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          {% endif %}

          <label for="ProductQuantity-{{ section.id }}">Quantity</label>
          <input id="ProductQuantity-{{ section.id }}" type="number" name="quantity" min="1" value="1">

          {% if can_add_to_cart %}
            <input type="submit" value="Add to cart">
            {{ form | payment_button }}
          {% else %}
            <input type="submit" value="Sold out" disabled>
          {% endif %}

          {% unless product.has_only_default_variant or product.variants.size == 1 %}
            <script>
              (() => {
                const productForm = document.currentScript.closest('form');
                const variantSelect = productForm.querySelector('select[name="id"]');
                const submitButton = productForm.querySelector('input[type="submit"]');

                if (!variantSelect || !submitButton) return;

                const updateButtonState = () => {
                  const selectedOption = variantSelect.options[variantSelect.selectedIndex];
                  const canAddToCart = selectedOption.dataset.available === 'true';

                  submitButton.value = canAddToCart ? 'Add to cart' : 'Sold out';
                  submitButton.disabled = !canAddToCart;
                };

                variantSelect.addEventListener('change', updateButtonState);
                updateButtonState();
              })();
            </script>
          {% endunless %}
        {% endform %}
      </div>
    </div>
  </div>

  <div class="obodesk-product__details">
    <article>
      <h2>Desk environment fit</h2>
      <p>Designed to support a cleaner, more intentional desk environment without adding visual noise.</p>
    </article>
    <article>
      <h2>Why it belongs on your desk</h2>
      <p>Selected for structure, focus, and daily flow across modern work sessions.</p>
    </article>
    <article>
      <h2>Setup notes</h2>
      <p>Pair with complementary desk essentials to build a more complete OboDesk setup.</p>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
