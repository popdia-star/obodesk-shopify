<header>
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__menu">
    <a href="{{ routes.root_url }}">Desk Setup</a>
    <a href="{{ routes.root_url }}">Lighting</a>
    <a href="{{ routes.root_url }}">Power</a>
    <a href="{{ routes.root_url }}">Desk Infrastructure</a>
    <a href="{{ routes.root_url }}">Kits</a>
    <a href="{{ routes.root_url }}">Learn</a>
    <a href="{{ routes.root_url }}">PRO</a>
  </div>

  <div class="header__icons">
    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  header .header__title {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  header a sup {
    position: absolute;
    left: 100%;
    overflow: hidden;
    max-width: var(--page-margin);
  }
  header svg {
    width: 2rem;
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }
  header .header__menu {
    flex: 1;
    justify-content: center;
    gap: clamp(0.75rem, 1.8vw, 1.5rem);
  }
  header .header__menu a {
    color: rgba(51, 51, 51, 0.78);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }
  header .header__menu a:hover {
    color: var(--color-foreground);
  }
  header .header__icons {
    flex-shrink: 0;
  }
  @media (max-width: 900px) {
    header .header__menu {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
