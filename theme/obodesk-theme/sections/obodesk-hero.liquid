<section class="obodesk-section obodesk-hero full-width">
  <div class="obodesk-container obodesk-hero__inner">
    <div class="obodesk-hero__content">
      <p class="obodesk-eyebrow">OboDesk</p>
      <h1>Build Your Desk Environment.</h1>
      <p class="obodesk-lede">Premium desk essentials designed for focus, flow, and visual atmosphere.</p>
      <div class="obodesk-actions">
        <a class="obodesk-button obodesk-button--primary" href="{{ collections['desk-setup'].url | default: routes.root_url }}">Explore essentials</a>
        <a class="obodesk-button obodesk-button--secondary" href="#obodesk-kits">View setup kits</a>
      </div>
    </div>

    <div class="obodesk-hero__panel" aria-label="Premium desk environment scene">
      <div class="obodesk-hero__ambient"></div>
      <div class="obodesk-hero__screen"></div>
      <div class="obodesk-hero__stand"></div>
      <div class="obodesk-hero__surface"></div>
      <div class="obodesk-hero__mat"></div>
      <div class="obodesk-hero__keyboard"></div>
      <div class="obodesk-hero__dock"></div>
      <div class="obodesk-hero__lightbar"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "OboDesk Hero",
  "settings": [],
  "presets": [
    {
      "name": "OboDesk Hero"
    }
  ]
}
{% endschema %}
