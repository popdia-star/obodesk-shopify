<section class="obodesk-section obodesk-hero full-width">
  <div class="obodesk-container obodesk-hero__inner">
    <div class="obodesk-hero__content">
      <p class="obodesk-eyebrow">OboDesk</p>
      <h1>Build Your<br>Desk<br>Environment.</h1>
      <p class="obodesk-lede">Premium desk essentials designed for focus, flow, and visual atmosphere.</p>
      <div class="obodesk-actions">
        <a class="obodesk-button obodesk-button--primary" href="{{ routes.collections_url }}/desk-setup">Shop the System</a>
        <a class="obodesk-button obodesk-button--secondary" href="{{ routes.collections_url }}/desk-infrastructure">Explore Desk Infrastructure</a>
      </div>
    </div>

    <picture class="obodesk-hero__media">
      <source
        media="(max-width: 749px)"
        srcset="{{ 'obodesk-hero-mobile-0506.jpg' | asset_url }}"
      >
      <img
        class="obodesk-hero__image"
        src="{{ 'obodesk-hero-workspace-050605.jpg' | asset_url }}"
        alt="OboDesk desktop system with monitor, light bar, desk riser, keyboard, mouse, desk mat, and warm workspace lighting"
        width="3172"
        height="1321"
        loading="eager"
        fetchpriority="high"
      >
    </picture>
  </div>
</section>

{% schema %}
{
  "name": "OboDesk Hero",
  "settings": [],
  "presets": [
    {
      "name": "OboDesk Hero"
    }
  ]
}
{% endschema %}
